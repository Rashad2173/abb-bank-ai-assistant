# Copy to .env and fill in. Never commit .env.
# Values in .env win over variables inherited from the machine's environment.

# --- OpenAI (chat service; text-embedding-3-large in the benchmark) ---------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# --- Where the services find each other (defaults: local development) -------
# MILVUS_URI=http://localhost:19530
# INFERENCE_URL=http://localhost:8004
# ANALYTICS_URL=http://localhost:8002
# DATABASE_URL=postgresql+psycopg://abb:abb@localhost:5433/abb_analytics

# --- Retrieval (chat service) -----------------------------------------------
# RETRIEVAL_METHOD=dense+sparse      # dense+sparse | dense+bm25 | dense+sparse+bm25 | dense
# RETRIEVAL_CANDIDATES=30            # chunks re-scored by the reranker
# CONTEXT_CHUNKS=10                  # chunks given to the LLM
# MIN_RERANK_SCORE=0.0               # drop reranked chunks below this relevance (0-1)
# RERANKER=http                      # http (inference service) | none (Milvus order)
# RERANK_TIMEOUT=5                   # seconds; slower -> answer from Milvus order

# --- Inference service ------------------------------------------------------
# INFERENCE_DEVICE=auto              # auto | cuda | cpu
# INFERENCE_LOAD_RERANKER=true
